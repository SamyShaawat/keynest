<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="res_groups_privilege_keynest" model="res.groups.privilege">
        <field name="name">KeyNest</field>
        <field name="category_id" ref="base.module_category_services"/>
    </record>

    <record id="group_keynest_user" model="res.groups">
        <field name="name">User</field>
        <field name="sequence">10</field>
        <field name="privilege_id" ref="res_groups_privilege_keynest"/>
        <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
    </record>

    <record id="group_keynest_manager" model="res.groups">
        <field name="name">Manager</field>
        <field name="sequence">20</field>
        <field name="privilege_id" ref="res_groups_privilege_keynest"/>
        <field name="implied_ids" eval="[(4, ref('group_keynest_user'))]"/>
        <field name="user_ids" eval="[(4, ref('base.user_root')), (4, ref('base.user_admin'))]"/>
    </record>
</odoo>
